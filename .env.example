# ==========================================
# OnboardIQ Configuration
# ==========================================

# Vultr Serverless Inference (Required for AI generation)
VULTR_INFERENCE_API_KEY=your_vultr_inference_api_key_here
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=llama-3.3-70b-instruct

# Slack Integration (Required for real Slack announcements)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_DEFAULT_CHANNEL=hackathon-demo

# GitHub Organization Integration (Real member invitations)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_ORG=TestCompany-OnboardIQ-Demo

# Gmail SMTP Dispatch (Real Day 0 welcome email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_demo_account@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=OnboardIQ People Operations

# ----------------------------------------------------
# Database Settings (Dual-Mode: Local vs Production)
# ----------------------------------------------------
# Mode 1: Local SQLite (Default for zero-overhead local development):
DATABASE_URL=sqlite:///./onboardiq.db

# Mode 2: Vultr Supabase Marketplace App (Production PostgreSQL):
# Format: postgresql://postgres:[PASSWORD]@[VULTR_SUPABASE_IP]:5432/postgres
# Example: DATABASE_URL=postgresql://postgres:mysecurepassword@192.0.2.100:5432/postgres

# Mode 3: Supabase Cloud Managed Postgres (Connection pooler port 6543):
# Example: DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# App & Network Ports
APP_ENV=production
BACKEND_PORT=8000
FRONTEND_PORT=4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost
